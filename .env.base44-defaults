# Placeholder environment values for the Base44 sandbox (docker-compose.base44.yml).
#
# Every value here is intentionally EMPTY: the app is designed to boot and run
# without any credentials —
#   * TMDB falls back to the API key already hardcoded in src/lib/services/tmdbService.ts
#   * Supabase falls back to a localStorage-backed mock client (src/lib/supabase/client.tsx)
#   * Streamtape download endpoints simply report "not configured"
#
# Real values are delivered by the platform to /run/base44/app.env, which is
# listed AFTER this file in compose and therefore overrides it. Never put a
# user-supplied credential in this file.

# TMDB (https://www.themoviedb.org/settings/api) — optional, a key is built in.
NEXT_PUBLIC_TMDB_API_KEY=

# Hosted Supabase project (https://supabase.com/dashboard) — optional; without it
# auth and saved lists are kept in the browser's localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Streamtape (https://streamtape.com/accapi) — optional, only used by the
# download endpoints under /api/streamtape.
STREAMTAPE_LOGIN=
STREAMTAPE_KEY=
STREAMTAPE_ADMIN_TOKEN=
